FROM node:alpine

WORKDIR /app

# Önce paketleri kopyala ve kur (Cache optimizasyonu için)
COPY package*.json ./
RUN npm install

# Sonra tüm proje dosyalarını kopyala
COPY . .

# Cloud Run konteynere PORT verir (genelde 8080); vite.config.js process.env.PORT ile dinler.
# Yerel imaj testi için varsayılan:
ENV PORT=8080
EXPOSE 8080

# Vite projesini Cloud Run'da dışarıya (0.0.0.0) açmak için --host parametresi şarttır
CMD ["npm", "run", "dev", "--", "--host"]